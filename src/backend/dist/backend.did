service : {
  activateDevice: (activationCode: text, intendedRole: opt StaffRole) ->
   (variant {
      err:
       variant {
         alreadyUsed;
         deviceAlreadyHasRole;
         expired;
         internal: text;
         notFound;
         roleMismatch: text;
       };
      ok:
       record {
         deviceName: text;
         deviceToken: text;
         restaurantId: nat;
         role: StaffRole;
       };
    });
  activateEnterpriseDevice: (activationCode: text, intendedRole:
   opt EnterpriseDeviceRole) ->
   (variant {
      err: text;
      ok: record {
            deviceId: text;
            deviceToken: text;
            role: text;
          };
    });
  addBannerImage: (imageUrl: text) -> (opt nat);
  addEnterpriseStaff: (principalId: principal) -> (variant {
                                                     err: text;
                                                     ok;
                                                   });
  addStaffMember: (restaurantId: RestaurantId, staffId: principal, role:
   StaffRole) -> (bool);
  assignCodDriver: (orderId: OrderId, driverPrincipal: principal) ->
   (variant {
      err: text;
      ok;
    });
  bookAhamoveShipper: (orderId: text) ->
   (variant {
      err: text;
      ok:
       record {
         ahamoveOrderId: text;
         distanceKm: float64;
         fare: nat;
         status: text;
       };
    });
  bookDriverForCodOrder: (orderId: OrderId) ->
   (variant {
      err: text;
      ok: record {
            ahamoveOrderId: text;
            fare: nat;
            status: text;
          };
    });
  bookShipper: (orderId: OrderId, restaurantId: RestaurantId) ->
   (variant {
      err: text;
      ok: ShipperBookingResult;
    });
  cancelOrder: (orderId: OrderId) ->
   (variant {
      err: variant {
             NotFound;
             Unauthorized;
             WrongStatus;
           };
      ok;
    });
  cancelReservation: (id: ReservationId) -> (bool);
  checkCodAllowed: (orderTotal: nat) -> (bool) query;
  checkFindingDriverTimeout: () -> (variant {
                                      err: text;
                                      ok: nat;
                                    });
  clearCompletedOrders: (restaurantId: RestaurantId) ->
   (variant {
      err: variant {Unauthorized;};
      ok: nat;
    });
  confirmAhamoveBooking: (orderId: OrderId, ahamoveOrderId: text, fare: 
   nat, status: text) ->
   (variant {
      err: text;
      ok: record {
            ahamoveOrderId: text;
            fare: nat;
            status: text;
          };
    });
  confirmDynamicQRDeleted: (payload: DynamicQRDeletedCallback) ->
   (variant {
      err: text;
      ok;
    });
  confirmDynamicQRGenerated: (payload: DynamicQRGeneratedCallback) ->
   (variant {
      err: text;
      ok;
    });
  confirmDynamicQRStatus: (payload: DynamicQRStatusCallback) ->
   (variant {
      err: text;
      ok;
    });
  confirmPayment: (orderId: OrderId, paymentIntentId: text) ->
   (variant {
      err: variant {
             NotFound;
             Unauthorized;
           };
      ok: bool;
    });
  confirmPaymentByCashier: (orderId: OrderId, restaurantId: RestaurantId) ->
   (variant {
      err: variant {
             NotFound;
             Unauthorized;
             WrongRestaurant;
           };
      ok: bool;
    });
  confirmPaymentByTingeeStatus: (orderId: OrderId, totalAmountPaid: nat,
   transactionCode: opt text) ->
   (variant {
      err:
       variant {
         AlreadyPaid;
         AmountMismatch;
         NotFound;
         NotTingeePending;
         Unauthorized;
       };
      ok: bool;
    });
  confirmReservation: (id: ReservationId) -> (bool);
  confirmTingeeBanks: (payload: TingeeBanksCallback) ->
   (variant {
      err: text;
      ok;
    });
  createCategory: (restaurantId: RestaurantId, name: text, position: 
   nat) -> (MenuCategoryId);
  createCodOrder: (request: CodOrderRequest) -> (CodOrderResponse);
  createMasterCategory: (req: CreateMasterCategoryRequest) ->
   (variant {
      err: text;
      ok: MasterMenuCategory;
    });
  createMasterMenuItem: (req: CreateMasterMenuItemRequest) ->
   (variant {
      err: text;
      ok: MasterMenuItem;
    });
  createMenuItem: (restaurantId: RestaurantId, categoryId: MenuCategoryId,
   name: text, description: text, price: nat, imageUrl: opt text, available:
   bool, unit: opt text) -> (MenuItemId);
  createPaymentIntent: (orderId: OrderId, method: PaymentMethod__1,
   restaurantId: RestaurantId) ->
   (variant {
      err: variant {
             NotFound;
             StripeNotEnabled;
             Unauthorized;
           };
      ok:
       record {
         bankDetails: opt BankDetails;
         currency: text;
         orderId: OrderId;
         publishableKey: opt text;
         totalAmount: nat;
       };
    });
  createReservation: (restaurantId: RestaurantId, customerName: text,
   customerPhone: text, partySize: nat, date: text, timeSlot: text,
   durationMinutes: nat, tableId: opt TableId, notes: opt text,
   customerEmail: opt text) -> (ReservationId);
  createRestaurant: (name: text) -> (RestaurantId);
  createTable: (restaurantId: RestaurantId, tableNumber: text) -> (TableId);
  deleteBackgroundImage: (id: nat) -> (variant {
                                         err: text;
                                         ok;
                                       });
  deleteBannerImage: (id: nat) -> (bool);
  deleteCategory: (restaurantId: RestaurantId, id: MenuCategoryId) -> (bool);
  deleteDynamicQR: (orderId: text) -> (variant {
                                         err: text;
                                         ok;
                                       });
  deleteMasterCategory: (id: nat) -> (variant {
                                        err: text;
                                        ok;
                                      });
  deleteMasterMenuItem: (id: nat) -> (variant {
                                        err: text;
                                        ok;
                                      });
  deleteMenuItem: (restaurantId: RestaurantId, id: MenuItemId) -> (bool);
  deleteRestaurant: (restaurantId: RestaurantId) -> (bool);
  deleteTable: (restaurantId: RestaurantId, id: TableId) -> (bool);
  execute: (qJson: text) -> (Result) query;
  findNearestRestaurant: (lat: float64, lng: float64) -> (opt nat) query;
  generateDynamicQR: (orderId: text, regenerateNonce: opt nat) ->
   (variant {
      err: text;
      ok: DynamicQRRecordPublic;
    });
  generateInvoiceCallbackSecret: () -> (variant {
                                          err: text;
                                          ok: text;
                                        });
  getAhamoveConfig: () -> (opt AhamoveConfig) query;
  getAhamoveOrderStatus: (orderId: OrderId) ->
   (variant {
      err: text;
      ok:
       record {
         ahamoveOrderId: opt text;
         driverInfo: opt DriverInfo;
         orderStatus: OrderStatus;
         shipperName: opt text;
         shipperPhone: opt text;
         shippingFee: opt nat;
         shippingProvider: opt text;
         shippingStatus: opt ShippingStatus;
       };
    });
  getAhamoveWorkerConfig: () ->
   (variant {
      err: text;
      ok: AhamoveWorkerConfig;
    }) query;
  getBannerImages: () -> (vec BannerImagePublic) query;
  getBkavInvoiceConfig: () ->
   (record {
      demoGuid: opt text;
      demoInvoiceSerial: text;
      demoToken: opt text;
      invoiceCallbackSecret: opt text;
      invoiceForm: text;
      invoiceSerial: text;
      prodInvoiceSerial: text;
      realApiUrl: opt text;
      realGuid: opt text;
      realToken: opt text;
      useDemo: bool;
      vatRate: nat;
      workerPrincipal: opt text;
    }) query;
  getBusinessBankDetails: (deviceToken: opt text) ->
   (opt BusinessBankDetails);
  getBusinessLogoUrl: () -> (text) query;
  getBusinessProfileInfo: () ->
   (record {
      address: opt text;
      brandLogo: opt text;
      businessName: opt text;
      domain: opt text;
      email: opt text;
      tingeeBankBin: opt text;
      tingeeMerchantId: opt text;
      tingeeVA: opt text;
    }) query;
  getCodDispatchOrders: () ->
   (variant {
      err: variant {Unauthorized;};
      ok: vec DispatchCenterOrder;
    }) query;
